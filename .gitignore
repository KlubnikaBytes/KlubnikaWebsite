# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets (CRITICAL: Never commit .env files)
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Build & Distribution Outputs
dist/
dist-ssr/
frontend/dist/
build/

# Uploaded Files & Resumes (Preserve directory structure via .gitkeep)
uploads/*
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
