PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/klubnikabytes?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key

# Admin Notification Mailer (Gmail)
EMAIL_USER=klubnika.bytes.email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Public Mailer Identity
EMAIL_FROM=info@klubnikabytes.com
EMAIL_FROM_NAME=Klubnika Bytes

# Dedicated SMTP for info@klubnikabytes.com (optional)
PUBLIC_SMTP_USER=info@klubnikabytes.com
PUBLIC_SMTP_PASS=
PUBLIC_SMTP_HOST=
PUBLIC_SMTP_PORT=465

# Recipient Notification Routing
CAREERS_EMAIL=hr@klubnikabytes.com,klubnika.bytes.email@gmail.com
CONTACT_EMAIL=info@klubnikabytes.com,klubnika.bytes.email@gmail.com
NEWSLETTER_NOTIFY_EMAIL=info@klubnikabytes.com,klubnika.bytes.email@gmail.com

# Default Admin Credentials
ADMIN_DEFAULT_EMAIL=hr@klubnikabytes.com
ADMIN_DEFAULT_PASSWORD=HR@KB
ADMIN_DEFAULT_ROLE=HR

NODE_ENV=development

